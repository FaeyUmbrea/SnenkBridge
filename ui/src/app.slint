import { Theme } from "components/theme.slint";
import { StyledInput, Btn, FieldLabel, UnitLabel, StatusBadge, Card, StyledCombo, GroupTag, VCenter, NameValuePair, EditorParam, VarEntry } from "components/common.slint";
import { AboutWindow, ImportDialog, NewPresetDialog, UnsavedChangesDialog, ActiveConnectionDialog, VariablesWindow } from "components/dialogs.slint";
import { ConnectionBar } from "components/connection-bar.slint";
import { PreviewTab } from "components/preview-tab.slint";
import { EditorTab } from "components/editor-tab.slint";

export { AboutWindow, ImportDialog, NewPresetDialog, UnsavedChangesDialog, ActiveConnectionDialog, VariablesWindow }
export { NameValuePair }
export { EditorParam }
export { VarEntry }

export component App inherits Window {
    title: "SnenkBridge";
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 1040px;
    min-height: 560px;
    preferred-width: 1320px;
    preferred-height: 820px;
    background: Theme.bg-window;

    in-out property<int> preset-index: 0;
    in property<[string]> preset-names: ["Default"];
    in-out property<bool> can-delete-preset: false;
    in-out property<string> phone-ip: "127.0.0.1";
    in-out property<int> tracking-type-index: 0;
    in-out property<string> face-search-timeout: "3000";
    in-out property<string> vts-ip: "localhost";
    in-out property<string> vts-port: "8001";

    in-out property<bool> source-active: false;
    in-out property<bool> target-active: false;
    in-out property<string> source-status: "Disconnected";
    in-out property<color> source-status-color: #cc4444;
    in-out property<string> target-status: "Disconnected";
    in-out property<color> target-status-color: #cc4444;
    in-out property<string> error-text;

    // New properties
    in-out property<int> active-tab: 0;
    in property<[NameValuePair]> input-shapes: [];
    in property<[NameValuePair]> output-params: [];
    in property<image> mesh-image;
    in property<bool> preview-paused: false;

    in-out property<string> editor-title;
    in-out property<string> editor-author;
    in-out property<string> editor-description;
    in-out property<[EditorParam]> editor-params: [];
    in property<[string]> editor-param-errors: [];
    in-out property<bool> has-unsaved-changes: false;

    callback editor-param-changed(int, EditorParam);
    callback editor-add-param();
    callback editor-add-delay-param();
    callback editor-delete-param(int);
    callback editor-metadata-changed();
    callback editor-save();
    callback editor-show-variables();

    callback import-preset();
    callback export-preset();
    callback delete-preset();
    callback toggle-source();
    callback toggle-target();
    callback settings-changed();
    callback show-about();
    callback new-preset();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top bar surface: tabs · preset management · about
        Rectangle {
            height: 48px;
            background: Theme.bg-panel;

            // Bottom hairline
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                spacing: 6px;

                // Tab pills
                VCenter {
                    HorizontalLayout {
                        spacing: 4px;

                        tab0 := Rectangle {
                            width: 82px;
                            height: Theme.control-height;
                            border-radius: Theme.radius;
                            background: root.active-tab == 0
                                ? Theme.accent
                                : (t0.has-hover ? Theme.bg-elevated : transparent);
                            t0 := TouchArea { clicked => { root.active-tab = 0; } }
                            Text {
                                text: "Preview";
                                color: root.active-tab == 0 ? Theme.accent-text : Theme.text-dim;
                                font-size: 12px;
                                font-weight: root.active-tab == 0 ? 600 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        tab1 := Rectangle {
                            width: 82px;
                            height: Theme.control-height;
                            border-radius: Theme.radius;
                            background: root.active-tab == 1
                                ? Theme.accent
                                : (t1.has-hover ? Theme.bg-elevated : transparent);
                            t1 := TouchArea { clicked => { root.active-tab = 1; } }
                            Text {
                                text: "Editor";
                                color: root.active-tab == 1 ? Theme.accent-text : Theme.text-dim;
                                font-size: 12px;
                                font-weight: root.active-tab == 1 ? 600 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { width: 18px; }

                // Preset management
                VCenter { GroupTag { label: "PRESET"; } }
                StyledCombo {
                    model: root.preset-names;
                    current-index <=> root.preset-index;
                    enabled: !root.target-active;
                    width: 184px;
                    selected(val) => { root.settings-changed(); }
                }
                Btn {
                    label: "New";
                    enabled: !root.target-active;
                    width: 50px;
                    clicked => { root.new-preset(); }
                }
                Btn {
                    label: "Import";
                    enabled: !root.target-active;
                    width: 64px;
                    clicked => { root.import-preset(); }
                }
                Btn {
                    label: "Export";
                    enabled: !root.target-active;
                    width: 64px;
                    clicked => { root.export-preset(); }
                }
                if root.can-delete-preset : Btn {
                    label: "Delete";
                    enabled: !root.target-active;
                    width: 60px;
                    base-bg: Theme.bad-bg;
                    hover-bg: #7a3030;
                    base-border: #6a3434;
                    hover-border: Theme.bad;
                    text-color: #f0bcbc;
                    clicked => { root.delete-preset(); }
                }

                // Spacer
                Rectangle { horizontal-stretch: 1; }

                // About link
                TouchArea {
                    width: 48px;
                    about-text := Text {
                        text: "About";
                        color: parent.has-hover ? Theme.text-dim : Theme.text-muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    clicked => { root.show-about(); }
                }
                }
            }
        }

        // Tab content (stretch)
        if root.active-tab == 0 : PreviewTab {
            vertical-stretch: 1;
            input-shapes: root.input-shapes;
            output-params: root.output-params;
            mesh-image: root.mesh-image;
            paused: root.preview-paused;
        }

        if root.active-tab == 1 : EditorTab {
            vertical-stretch: 1;
            preset-title <=> root.editor-title;
            preset-author <=> root.editor-author;
            preset-description <=> root.editor-description;
            params <=> root.editor-params;
            param-errors: root.editor-param-errors;
            has-unsaved-changes: root.has-unsaved-changes;
            param-changed(idx, p) => { root.editor-param-changed(idx, p); }
            add-param => { root.editor-add-param(); }
            add-delay-param => { root.editor-add-delay-param(); }
            delete-param(idx) => { root.editor-delete-param(idx); }
            metadata-changed => { root.editor-metadata-changed(); }
            save => { root.editor-save(); }
            show-variables => { root.editor-show-variables(); }
        }

        // Connection bar
        ConnectionBar {
            phone-ip <=> root.phone-ip;
            tracking-type-index <=> root.tracking-type-index;
            face-search-timeout <=> root.face-search-timeout;
            source-active <=> root.source-active;
            source-status <=> root.source-status;
            source-status-color <=> root.source-status-color;

            vts-ip <=> root.vts-ip;
            vts-port <=> root.vts-port;
            target-active <=> root.target-active;
            target-status <=> root.target-status;
            target-status-color <=> root.target-status-color;

            toggle-source => { root.toggle-source(); }
            toggle-target => { root.toggle-target(); }
            settings-changed => { root.settings-changed(); }
        }

        // Error text
        if root.error-text != "" : Rectangle {
            height: 24px;
            Text {
                text: root.error-text;
                color: #e05a5a;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
