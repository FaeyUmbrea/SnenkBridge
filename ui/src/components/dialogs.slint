import { Theme } from "theme.slint";
import { StyledInput, Btn, FieldLabel, StyledCombo, VarEntry } from "common.slint";

export component VariablesWindow inherits Window {
    title: "Expression Variables";
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 400px;
    min-height: 420px;
    preferred-width: 440px;
    preferred-height: 540px;
    background: Theme.bg-window;

    in property<[VarEntry]> entries;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "Expression Variables";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: "Reference these names in parameter expressions. Wave⟨ms⟩ and PingPong⟨ms⟩ take a cycle length in milliseconds, e.g. Wave2000.";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle { height: 1px; background: Theme.border; }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            vw-flick := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: list.preferred-height;

                list := VerticalLayout {
                    spacing: 2px;
                    padding-right: 8px;
                    alignment: start;

                    for e in root.entries : Rectangle {
                        height: e.header ? 24px : 19px;

                        HorizontalLayout {
                            padding-top: e.header ? 6px : 0;
                            spacing: 8px;

                            if e.header : Text {
                                text: e.name;
                                color: Theme.text-dim;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: bottom;
                            }
                            if !e.header : Text {
                                text: e.name;
                                color: #e07f78;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 170px;
                            }
                            if !e.header : Text {
                                text: e.note;
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            if vw-flick.viewport-height > vw-flick.height : Rectangle {
                x: parent.width - 5px;
                width: 4px;
                background: Theme.bg-input;
                border-radius: 2px;

                Rectangle {
                    x: 0;
                    width: parent.width;
                    border-radius: 2px;
                    background: Theme.border-strong;
                    height: max(28px, parent.height * (vw-flick.height / vw-flick.viewport-height));
                    y: (parent.height - self.height)
                        * ((-vw-flick.viewport-y) / (vw-flick.viewport-height - vw-flick.height));
                }
            }
        }
    }
}

export component AboutWindow inherits Window {
    title: "About SnenkBridge";
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 400px;
    min-height: 350px;
    preferred-width: 400px;
    preferred-height: 400px;
    background: Theme.bg-window;

    in property<string> credits-text;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "SnenkBridge";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        Text {
            text: "github.com/FaeyUmbrea/SnenkBridge";
            color: #b8706a;
            font-size: 12px;
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text {
            text: "Presets";
            color: Theme.text-dim;
            font-size: 12px;
            font-weight: 700;
        }
        Text {
            text: "Maruseu VBridger and Maruseu Enhanced presets based on presets by Maruseu (github.com/maruseu/VitaminsPresets), included with permission. These presets are not covered by the project's GPL license.";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle { height: 1px; background: Theme.border; }

        Text {
            text: "Dependencies";
            color: Theme.text-dim;
            font-size: 12px;
            font-weight: 700;
        }

        Flickable {
            vertical-stretch: 1;
            viewport-height: deps-text.preferred-height;
            deps-text := Text {
                text: root.credits-text;
                color: #555570;
                font-size: 10px;
                wrap: word-wrap;
                width: parent.width;
            }
        }
    }
}

export component ImportDialog inherits Window {
    title: "Import Preset";
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 380px;
    min-height: 260px;
    preferred-width: 380px;
    preferred-height: 260px;
    background: Theme.bg-window;

    in-out property<string> preset-title;
    in-out property<string> preset-author;
    in-out property<string> preset-description;
    in-out property<bool> show-swap-toggle: false;
    in-out property<bool> swap-xy: false;

    callback do-import();
    callback do-cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Import Preset";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Title"; }
            StyledInput {
                text <=> root.preset-title;
                placeholder: "Preset name";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Author"; }
            StyledInput {
                text <=> root.preset-author;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Desc"; }
            StyledInput {
                text <=> root.preset-description;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        if root.show-swap-toggle : HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: ""; }
            TouchArea {
                width: 16px;
                height: 16px;
                clicked => { root.swap-xy = !root.swap-xy; }
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-width: 1px;
                    border-radius: 3px;
                    border-color: #b8706a;
                    background: root.swap-xy ? #d24b46 : transparent;
                }
            }
            Text {
                text: "Swap pitch/yaw X/Y alignment";
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                label: "Cancel";
                width: 80px;
                base-bg: #2a2a48;
                hover-bg: #3a3a5c;
                base-border: #3d3d5c;
                hover-border: #b8706a;
                clicked => { root.do-cancel(); }
            }
            Btn {
                label: "Import";
                width: 80px;
                base-bg: #d24b46;
                hover-bg: #e25a54;
                base-border: #b8706a;
                hover-border: #ee8b84;
                text-color: #fff0ef;
                clicked => { root.do-import(); }
            }
        }
    }
}

export component NewPresetDialog inherits Window {
    title: "New Preset";
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 380px;
    min-height: 280px;
    preferred-width: 380px;
    preferred-height: 280px;
    background: Theme.bg-window;

    in-out property<string> preset-title;
    in-out property<string> preset-author;
    in-out property<string> preset-description;
    in-out property<int> base-preset-index: 0;
    in property<[string]> base-preset-names: ["Empty"];

    callback do-create();
    callback do-cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "New Preset";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Title"; }
            StyledInput {
                text <=> root.preset-title;
                placeholder: "Preset name";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Author"; }
            StyledInput {
                text <=> root.preset-author;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Desc"; }
            StyledInput {
                text <=> root.preset-description;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Base"; }
            StyledCombo {
                model: root.base-preset-names;
                current-index <=> root.base-preset-index;
                horizontal-stretch: 1;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                label: "Cancel";
                width: 80px;
                base-bg: #2a2a48;
                hover-bg: #3a3a5c;
                base-border: #3d3d5c;
                hover-border: #b8706a;
                clicked => { root.do-cancel(); }
            }
            Btn {
                label: "Create";
                width: 80px;
                base-bg: #d24b46;
                hover-bg: #e25a54;
                base-border: #b8706a;
                hover-border: #ee8b84;
                text-color: #fff0ef;
                clicked => { root.do-create(); }
            }
        }
    }
}

export component UnsavedChangesDialog inherits Window {
    title: "Unsaved Changes";
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 340px;
    min-height: 140px;
    preferred-width: 340px;
    preferred-height: 140px;
    background: Theme.bg-window;

    callback do-save();
    callback do-discard();
    callback do-cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "You have unsaved changes.\nWhat would you like to do?";
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                label: "Cancel";
                width: 80px;
                base-bg: #2a2a48;
                hover-bg: #3a3a5c;
                base-border: #3d3d5c;
                hover-border: #b8706a;
                clicked => { root.do-cancel(); }
            }
            Btn {
                label: "Discard";
                width: 80px;
                base-bg: #6b2a2a;
                hover-bg: #883838;
                base-border: #994444;
                hover-border: #bb5555;
                text-color: #ffcccc;
                clicked => { root.do-discard(); }
            }
            Btn {
                label: "Save";
                width: 80px;
                base-bg: #d24b46;
                hover-bg: #e25a54;
                base-border: #b8706a;
                hover-border: #ee8b84;
                text-color: #fff0ef;
                clicked => { root.do-save(); }
            }
        }
    }
}

export component ActiveConnectionDialog inherits Window {
