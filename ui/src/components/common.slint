import { Theme } from "theme.slint";

export struct NameValuePair {
    name: string,
    value: float,
    // Range used to draw the value meter. Defaults to 0..1.
    min: float,
    max: float,
}

export struct VarEntry {
    name: string,
    note: string,
    header: bool,
}

export struct EditorParam {
    name: string,
    func: string,
    min: float,
    max: float,
    default-value: float,
    // When true this param is driven by a delay buffer (a smoothed/delayed
    // follow of `ref-param`) instead of `func`. The fields below apply only
    // then.
    is-delay: bool,
    ref-param: string,
    smoothing: float,
    delay-count: float,
    in-min: float,
    in-max: float,
    out-min: float,
    out-max: float,
}

export component StyledInput inherits Rectangle {
    in property<string> placeholder;
    in-out property<string> text <=> input.text;
    in property<bool> enabled: true;
    in property<bool> round-right: true;
    in property<bool> round-left: true;
    in property<bool> error: false;

    callback edited(string);

    border-top-left-radius: root.round-left ? Theme.radius : 0;
    border-bottom-left-radius: root.round-left ? Theme.radius : 0;
    border-top-right-radius: root.round-right ? Theme.radius : 0;
    border-bottom-right-radius: root.round-right ? Theme.radius : 0;
    border-width: 1px;
    border-color: root.error
        ? (input.has-focus ? #e06666 : #b04444)
        : (root.enabled ? (input.has-focus ? Theme.border-focus : Theme.border) : Theme.border);
    background: root.enabled ? Theme.bg-input : Theme.bg-disabled;
    height: Theme.control-height;

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        vertical-alignment: center;
        color: root.enabled ? Theme.text : Theme.text-muted;
        font-size: 13px;
        enabled: root.enabled;
        edited => { root.edited(self.text); }
    }

    if input.text == "" : Text {
        x: 10px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.placeholder;
        font-size: 13px;
        text: root.placeholder;
    }
}

export component Btn inherits Rectangle {
    in property<string> label;
    in property<bool> enabled: true;
    in property<color> base-bg: Theme.btn-bg;
    in property<color> hover-bg: Theme.btn-hover;
    in property<color> base-border: Theme.border-strong;
    in property<color> hover-border: Theme.accent;
    in property<color> text-color: Theme.text;
    in property<bool> round-left: true;
    in property<bool> round-right: true;

    callback clicked;

    border-top-left-radius: root.round-left ? Theme.radius : 0;
    border-bottom-left-radius: root.round-left ? Theme.radius : 0;
    border-top-right-radius: root.round-right ? Theme.radius : 0;
    border-bottom-right-radius: root.round-right ? Theme.radius : 0;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? root.hover-border : root.base-border;
    background: touch.has-hover && root.enabled ? root.hover-bg : root.base-bg;
    height: Theme.control-height;
    opacity: root.enabled ? 1.0 : 0.45;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: root.text-color;
        font-size: 13px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Form label that vertically centres itself next to a taller input.
export component FieldLabel inherits VerticalLayout {
    in property<string> text;
    alignment: center;
    horizontal-stretch: 0;

    Text {
        text: root.text;
        color: Theme.text-dim;
        font-size: 12px;
        min-width: 62px;
        vertical-alignment: center;
    }
}

export component UnitLabel inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    vertical-alignment: center;
}

// Compact label sitting before an input.
export component InlineLabel inherits Text {
    color: Theme.text-dim;
    font-size: 11px;
    vertical-alignment: center;
}

// Centres a short child vertically in a taller row (Slint top-aligns otherwise).
export component VCenter inherits VerticalLayout {
    alignment: center;
    horizontal-stretch: 0;
    @children
}

// A label hugging its input, kept together as one unit.
export component Field inherits HorizontalLayout {
    in property<string> label;
    spacing: 6px;
    alignment: start;
    horizontal-stretch: 0;

    VCenter {
        InlineLabel { text: root.label; }
    }

    @children
}

// Small uppercase pill labelling a control group (SOURCE / TARGET / PRESET).
export component GroupTag inherits Rectangle {
    in property<string> label;
    width: 58px;
    height: 20px;
    border-radius: 5px;
    background: Theme.bg-elevated;
    border-width: 1px;
    border-color: Theme.border-strong;

    Text {
        text: root.label;
        color: #c79a9a;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component StatusBadge inherits Rectangle {
    in property<color> dot-color: Theme.text-muted;
    in property<string> label: "Disconnected";

    HorizontalLayout {
        spacing: 6px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot-color;
            }
        }

        Text {
            text: root.label;
            color: root.dot-color;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.bg-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        @children
    }
}

// Themed dropdown replacing the native ComboBox so it matches the dark UI.
export component StyledCombo inherits Rectangle {
    in property<[string]> model;
    in-out property<int> current-index;
    in property<bool> enabled: true;
    callback selected(int);

    height: Theme.control-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.enabled ? (touch.has-hover ? Theme.border-strong : Theme.border) : Theme.border;
    background: root.enabled ? Theme.bg-input : Theme.bg-disabled;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 4px;

        Text {
            text: (root.current-index >= 0 && root.current-index < root.model.length)
                ? root.model[root.current-index]
                : "";
            color: root.enabled ? Theme.text : Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: "▾";
            color: Theme.text-dim;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 3px;
        width: root.width;

        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border-strong;

            VerticalLayout {
                padding: 4px;
                spacing: 1px;

                for item[idx] in root.model : Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: opt.has-hover ? Theme.bg-hover : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: item;
                            color: idx == root.current-index ? Theme.highlight : Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    opt := TouchArea {
                        clicked => {
                            root.current-index = idx;
                            root.selected(idx);
                        }
                    }
                }
            }
        }
    }
}
