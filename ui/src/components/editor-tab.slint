import { Theme } from "theme.slint";
import { StyledInput, Btn, FieldLabel, VCenter, EditorParam } from "common.slint";

// A small labelled numeric field used for the delay-buffer parameters.
component LabeledNum inherits HorizontalLayout {
    in property<string> label;
    in-out property<string> text;
    in property<length> field-width: 54px;
    callback edited(string);

    spacing: 5px;
    alignment: start;
    horizontal-stretch: 0;

    VCenter {
        Text {
            text: root.label;
            color: Theme.text-dim;
            font-size: 11px;
        }
    }

    StyledInput {
        width: root.field-width;
        text <=> root.text;
        edited(t) => { root.edited(t); }
    }
}

component ParamRow inherits Rectangle {
    in-out property<string> param-name;
    in-out property<string> param-func;
    in-out property<string> param-min;
    in-out property<string> param-max;
    in-out property<string> param-default;
    in property<bool> is-delay;
    // Expression parse error for this row; empty when valid.
    in property<string> error-text;
    in-out property<string> param-ref;
    in-out property<string> param-smoothing;
    in-out property<string> param-delay;
    in-out property<string> param-inmin;
    in-out property<string> param-inmax;
    in-out property<string> param-outmin;
    in-out property<string> param-outmax;
    in property<int> row-index;

    callback changed(int, EditorParam);
    callback delete(int);

    // Build the current row state as an EditorParam for the changed callback.
    pure function make-param() -> EditorParam {
        return {
            name: root.param-name,
            func: root.param-func,
            min: root.param-min == "" ? 0.0 : root.param-min.to-float(),
            max: root.param-max == "" ? 0.0 : root.param-max.to-float(),
            default-value: root.param-default == "" ? 0.0 : root.param-default.to-float(),
            is-delay: root.is-delay,
            ref-param: root.param-ref,
            smoothing: root.param-smoothing == "" ? 0.0 : root.param-smoothing.to-float(),
            delay-count: root.param-delay == "" ? 0.0 : root.param-delay.to-float(),
            in-min: root.param-inmin == "" ? 0.0 : root.param-inmin.to-float(),
            in-max: root.param-inmax == "" ? 0.0 : root.param-inmax.to-float(),
            out-min: root.param-outmin == "" ? 0.0 : root.param-outmin.to-float(),
            out-max: root.param-outmax == "" ? 0.0 : root.param-outmax.to-float(),
        };
    }

    property<bool> has-error: !root.is-delay && root.error-text != "";

    background: Math.mod(root.row-index, 2) == 0 ? Theme.bg-panel : #1b1b1d;
    border-radius: 4px;
    height: root.is-delay ? 74px : (root.has-error ? 58px : 38px);

    // Accent stripe marking delay-buffer rows.
    if root.is-delay : Rectangle {
        x: 0;
        width: 3px;
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
        background: #b8706a;
    }

    VerticalLayout {
        padding-left: 6px;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        // Line 1: name | expression/ref | min | max | default | delete
        HorizontalLayout {
            spacing: 4px;

            StyledInput {
                width: 160px;
                text <=> root.param-name;
                placeholder: "name";
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }

            // Expression rows show the expression; delay rows show the
            // referenced parameter they follow. A row's type is fixed, so
            // exactly one of these is present.
            if !root.is-delay : StyledInput {
                horizontal-stretch: 1;
                text <=> root.param-func;
                placeholder: "expression";
                error: root.has-error;
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }
            if root.is-delay : StyledInput {
                horizontal-stretch: 1;
                text <=> root.param-ref;
                placeholder: "follows parameter…";
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }

            StyledInput {
                width: 60px;
                text <=> root.param-min;
                placeholder: "min";
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }

            StyledInput {
                width: 60px;
                text <=> root.param-max;
                placeholder: "max";
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }

            StyledInput {
                width: 60px;
                text <=> root.param-default;
                placeholder: "default";
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }

            Btn {
                width: 30px;
                label: "X";
                base-bg: #3d1a1a;
                hover-bg: #6b2020;
                base-border: #5a2a2a;
                hover-border: #cc4444;
                text-color: #e08080;
                clicked => { root.delete(root.row-index); }
            }
        }

        // Inline parse-error message for invalid expressions, indented to sit
        // under the expression field.
        if root.has-error : HorizontalLayout {
            padding-left: 164px;

            Text {
                text: root.error-text;
                color: #e06666;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // Line 2: delay-buffer detail fields (only for delay rows).
        if root.is-delay : HorizontalLayout {
            spacing: 12px;
            alignment: start;

            LabeledNum {
                label: "Smoothing";
                text <=> root.param-smoothing;
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }
            LabeledNum {
                label: "Delay";
                text <=> root.param-delay;
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }
            LabeledNum {
                label: "In min";
                text <=> root.param-inmin;
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }
            LabeledNum {
                label: "In max";
                text <=> root.param-inmax;
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }
            LabeledNum {
                label: "Out min";
                text <=> root.param-outmin;
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }
            LabeledNum {
                label: "Out max";
                text <=> root.param-outmax;
                edited(t) => { root.changed(root.row-index, root.make-param()); }
            }
        }
    }
}

export component EditorTab inherits Rectangle {
    in-out property<string> preset-title;
    in-out property<string> preset-author;
    in-out property<string> preset-description;
    in-out property<[EditorParam]> params;
    // Per-row expression parse errors, index-aligned with `params`. Kept out of
    // the param model so revalidation never disturbs a focused input.
    in property<[string]> param-errors;
    in-out property<bool> has-unsaved-changes: false;

    callback param-changed(int, EditorParam);
    callback add-param();
    callback add-delay-param();
    callback delete-param(int);
    callback metadata-changed();
    callback save();
    callback show-variables();

    background: transparent;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        // 1. Metadata row
        Rectangle {
            background: Theme.bg-panel;
            border-radius: 6px;
            height: 48px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                // Title field (horizontal-stretch 2)
                StyledInput {
                    horizontal-stretch: 2;
                    text <=> root.preset-title;
                    placeholder: "Preset Title";
                    edited(_) => { root.metadata-changed(); }
                }

                // Author field (horizontal-stretch 1)
                StyledInput {
                    horizontal-stretch: 1;
                    text <=> root.preset-author;
                    placeholder: "Author";
                    edited(_) => { root.metadata-changed(); }
                }

                // Description field (horizontal-stretch 2)
                StyledInput {
                    horizontal-stretch: 2;
                    text <=> root.preset-description;
                    placeholder: "Description";
                    edited(_) => { root.metadata-changed(); }
                }

                // Save button
                Btn {
                    width: 80px;
                    label: root.has-unsaved-changes ? "Save *" : "Save";
                    base-bg: root.has-unsaved-changes ? #1a3d2a : Theme.border;
                    hover-bg: root.has-unsaved-changes ? #2a5a3a : #3d3d6b;
                    base-border: root.has-unsaved-changes ? #2a6a3a : #3a3a5a;
                    hover-border: root.has-unsaved-changes ? #44bb66 : #b8706a;
                    text-color: root.has-unsaved-changes ? #66ddaa : #c8c8e0;
                    clicked => { root.save(); }
                }
            }
        }

        // 2. Column headers
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            height: 18px;

            Text {
                width: 160px;
                text: "Name";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: "Expression / Follows";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                width: 60px;
                text: "Min";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                width: 60px;
                text: "Max";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                width: 60px;
                text: "Default";
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }

            // Spacer for delete column
            Rectangle {
                width: 30px;
            }
        }

        // 3. Scrollable param list with a thin overlay scrollbar.
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            ed-flick := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: params-layout.preferred-height;

                params-layout := VerticalLayout {
                    spacing: 2px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    padding-right: 8px;
                    alignment: start;

                    for param[index] in root.params : ParamRow {
                        row-index: index;
                        error-text: index < root.param-errors.length ? root.param-errors[index] : "";
                        param-name: param.name;
                        param-func: param.func;
                        param-min: param.min + "";
                        param-max: param.max + "";
                        param-default: param.default-value + "";
                        is-delay: param.is-delay;
                        param-ref: param.ref-param;
                        param-smoothing: param.smoothing + "";
                        param-delay: param.delay-count + "";
                        param-inmin: param.in-min + "";
                        param-inmax: param.in-max + "";
                        param-outmin: param.out-min + "";
                        param-outmax: param.out-max + "";
                        changed(idx, p) => { root.param-changed(idx, p); }
                        delete(idx) => { root.delete-param(idx); }
                    }
                }
            }

            if ed-flick.viewport-height > ed-flick.height : Rectangle {
                x: parent.width - 5px;
                width: 4px;
                background: Theme.bg-input;
                border-radius: 2px;

                Rectangle {
                    x: 0;
                    width: parent.width;
                    border-radius: 2px;
                    background: Theme.border-strong;
                    height: max(28px, parent.height * (ed-flick.height / ed-flick.viewport-height));
                    y: (parent.height - self.height)
                        * ((-ed-flick.viewport-y) / (ed-flick.viewport-height - ed-flick.height));
                }
            }
        }

        // 4. Action row: variables reference (left) + add buttons (right)
        HorizontalLayout {
            height: 34px;
            spacing: 6px;

            Btn {
                width: 120px;
                label: "ƒ Variables";
                base-bg: Theme.border;
                hover-bg: #3d3d6b;
                clicked => { root.show-variables(); }
            }

            Rectangle { horizontal-stretch: 1; }

            Btn {
                width: 150px;
                label: "+ Add Delay Buffer";
                clicked => { root.add-delay-param(); }
            }

            Btn {
                width: 140px;
                label: "+ Add Parameter";
                clicked => { root.add-param(); }
            }
        }
    }
}
