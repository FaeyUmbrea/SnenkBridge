import { Theme } from "theme.slint";
import { StyledInput, Btn, FieldLabel, StyledCombo, VarEntry } from "common.slint";
import { AboutSlint } from "std-widgets.slint";

export component VariablesWindow inherits Window {
    title: "Expression Variables";
    icon: @image-url("../../resources/SnenkBridgeIcon.svg");
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 400px;
    min-height: 420px;
    preferred-width: 440px;
    preferred-height: 540px;
    background: Theme.bg-window;

    in property<[VarEntry]> entries;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "Expression Variables";
            color: Theme.text;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: "Reference these names in parameter expressions. Wave⟨ms⟩ and PingPong⟨ms⟩ take a cycle length in milliseconds, e.g. Wave2000.";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle { height: 1px; background: Theme.border; }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            vw-flick := Flickable {
                width: parent.width;
                height: parent.height;
                content-height: list.preferred-height;

                list := VerticalLayout {
                    spacing: 2px;
                    padding-right: 8px;
                    alignment: start;

                    for e in root.entries : Rectangle {
                        height: e.header ? 24px : 19px;

                        HorizontalLayout {
                            padding-top: e.header ? 6px : 0;
                            spacing: 8px;

                            if e.header : Text {
                                text: e.name;
                                color: Theme.text-dim;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: bottom;
                            }
                            if !e.header : Text {
                                text: e.name;
                                color: #e07f78;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 170px;
                            }
                            if !e.header : Text {
                                text: e.note;
                                color: Theme.text-muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            if vw-flick.content-height > vw-flick.height : Rectangle {
                x: parent.width - 5px;
                width: 4px;
                background: Theme.bg-input;
                border-radius: 2px;

                Rectangle {
                    x: 0;
                    width: parent.width;
                    border-radius: 2px;
                    background: Theme.border-strong;
                    height: max(28px, parent.height * (vw-flick.height / vw-flick.content-height));
                    y: (parent.height - self.height)
                        * ((-vw-flick.content-y) / (vw-flick.content-height - vw-flick.height));
                }
            }
        }
    }
}

export component AboutWindow inherits Window {
    title: "About SnenkBridge";
    icon: @image-url("../../resources/SnenkBridgeIcon.svg");
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 440px;
    min-height: 480px;
    preferred-width: 460px;
    preferred-height: 520px;
    background: Theme.bg-window;

    in property<string> credits-text;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        // Header with app icon and project info
        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            Image {
                source: @image-url("../../resources/SnenkBridgeIcon.svg");
                width: 44px;
                height: 44px;
            }

            VerticalLayout {
                alignment: center;
                spacing: 3px;

                Text {
                    text: "SnenkBridge";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                }

                Text {
                    text: "github.com/FaeyUmbrea/SnenkBridge";
                    color: Theme.highlight;
                    font-size: 11px;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        // Presets notice card
        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 10px;
                spacing: 4px;

                Text {
                    text: "Presets";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                }

                Text {
                    text: "Maruseu VBridger and Maruseu Enhanced presets based on presets by Maruseu (github.com/maruseu/VitaminsPresets), included with permission. These presets are not covered by the project's GPL license.";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // Dependencies section with framed scroll box
        VerticalLayout {
            spacing: 6px;
            vertical-stretch: 1;

            Text {
                text: "Dependencies";
                color: Theme.text-dim;
                font-size: 11px;
                font-weight: 600;
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                deps-flick := Flickable {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    content-height: deps-text.preferred-height;

                    deps-text := Text {
                        text: root.credits-text;
                        color: Theme.text-dim;
                        font-size: 11px;
                        wrap: word-wrap;
                        width: parent.width;
                    }
                }

                if deps-flick.content-height > deps-flick.height : Rectangle {
                    x: parent.width - 6px;
                    y: 4px;
                    width: 4px;
                    height: parent.height - 8px;
                    background: Theme.bg-input;
                    border-radius: 2px;

                    Rectangle {
                        x: 0;
                        width: parent.width;
                        border-radius: 2px;
                        background: Theme.border-strong;
                        height: max(20px, parent.height * (deps-flick.height / deps-flick.content-height));
                        y: (parent.height - self.height)
                            * ((-deps-flick.content-y) / (deps-flick.content-height - deps-flick.height));
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        AboutSlint {}
    }
}

export component ImportDialog inherits Window {
    title: "Import Preset";
    icon: @image-url("../../resources/SnenkBridgeIcon.svg");
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 380px;
    min-height: 260px;
    preferred-width: 380px;
    preferred-height: 260px;
    background: Theme.bg-window;

    in-out property<string> preset-title;
    in-out property<string> preset-author;
    in-out property<string> preset-description;
    in-out property<bool> show-swap-toggle: false;
    in-out property<bool> swap-xy: false;

    callback do-import();
    callback do-cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "Import Preset";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Title"; }
            StyledInput {
                text <=> root.preset-title;
                placeholder: "Preset name";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Author"; }
            StyledInput {
                text <=> root.preset-author;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Desc"; }
            StyledInput {
                text <=> root.preset-description;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        if root.show-swap-toggle : HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: ""; }
            TouchArea {
                width: 16px;
                height: 16px;
                clicked => { root.swap-xy = !root.swap-xy; }
                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-width: 1px;
                    border-radius: 3px;
                    border-color: #b8706a;
                    background: root.swap-xy ? #d24b46 : transparent;
                }
            }
            Text {
                text: "Swap pitch/yaw X/Y alignment";
                color: Theme.text-dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                label: "Cancel";
                width: 80px;
                base-bg: #2a2a48;
                hover-bg: #3a3a5c;
                base-border: #3d3d5c;
                hover-border: #b8706a;
                clicked => { root.do-cancel(); }
            }
            Btn {
                label: "Import";
                width: 80px;
                base-bg: #d24b46;
                hover-bg: #e25a54;
                base-border: #b8706a;
                hover-border: #ee8b84;
                text-color: #fff0ef;
                clicked => { root.do-import(); }
            }
        }
    }
}

export component NewPresetDialog inherits Window {
    title: "New Preset";
    icon: @image-url("../../resources/SnenkBridgeIcon.svg");
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 380px;
    min-height: 280px;
    preferred-width: 380px;
    preferred-height: 280px;
    background: Theme.bg-window;

    in-out property<string> preset-title;
    in-out property<string> preset-author;
    in-out property<string> preset-description;
    in-out property<int> base-preset-index: 0;
    in property<[string]> base-preset-names: ["Empty"];

    callback do-create();
    callback do-cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "New Preset";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Title"; }
            StyledInput {
                text <=> root.preset-title;
                placeholder: "Preset name";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Author"; }
            StyledInput {
                text <=> root.preset-author;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Desc"; }
            StyledInput {
                text <=> root.preset-description;
                placeholder: "Optional";
                horizontal-stretch: 1;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: "Base"; }
            StyledCombo {
                model: root.base-preset-names;
                current-index <=> root.base-preset-index;
                horizontal-stretch: 1;
            }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                label: "Cancel";
                width: 80px;
                base-bg: #2a2a48;
                hover-bg: #3a3a5c;
                base-border: #3d3d5c;
                hover-border: #b8706a;
                clicked => { root.do-cancel(); }
            }
            Btn {
                label: "Create";
                width: 80px;
                base-bg: #d24b46;
                hover-bg: #e25a54;
                base-border: #b8706a;
                hover-border: #ee8b84;
                text-color: #fff0ef;
                clicked => { root.do-create(); }
            }
        }
    }
}

export component UnsavedChangesDialog inherits Window {
    title: "Unsaved Changes";
    icon: @image-url("../../resources/SnenkBridgeIcon.svg");
    default-font-family: "Inter, SF Pro, Segoe UI, sans-serif";
    default-font-size: 13px;
    min-width: 340px;
    min-height: 140px;
    preferred-width: 340px;
    preferred-height: 140px;
    background: Theme.bg-window;

    callback do-save();
    callback do-discard();
    callback do-cancel();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        Text {
            text: "You have unsaved changes.\nWhat would you like to do?";
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Btn {
                label: "Cancel";
                width: 80px;
                base-bg: #2a2a48;
                hover-bg: #3a3a5c;
                base-border: #3d3d5c;
                hover-border: #b8706a;
                clicked => { root.do-cancel(); }
            }
            Btn {
                label: "Discard";
                width: 80px;
                base-bg: #6b2a2a;
                hover-bg: #883838;
                base-border: #994444;
                hover-border: #bb5555;
                text-color: #ffcccc;
                clicked => { root.do-discard(); }
            }
            Btn {
                label: "Save";
                width: 80px;
                base-bg: #d24b46;
                hover-bg: #e25a54;
                base-border: #b8706a;
                hover-border: #ee8b84;
                text-color: #fff0ef;
                clicked => { root.do-save(); }
            }
        }
    }
}

