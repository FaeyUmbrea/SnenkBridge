            Btn {
                label: "Close";
                width: 80px;
                base-bg: #6b2a2a;
                hover-bg: #883838;
                base-border: #994444;
                hover-border: #bb5555;
                text-color: #ffcccc;
                clicked => { root.do-close(); }
            }
        }
    }
